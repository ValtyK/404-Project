
/* commentaire qque part dans le code */

melo_piano = {
    n(C4, C4@D5@E#4, C4, D4) | b(E4, D4) |
    n(C4, E4, D4, D4) | r(C4) |
}

melo_piano_2 = { c(D3, D3, D3, D3, D3, D3, D3, D3) | r(C4) | }

/*
    La fonction play ecrit une melodie dans le .wav
    param. 1 = melodie a jouer
    param. 2 = mesures jouees dans la melodie
*/

x = { n(D3, D3, D4, D3) |}
y = { x | x | }

play(melo_piano, 1:3)
play(melo_piano, 4)

x = 0
while (x < 4) {
    play(melo_piano_2, 1:2)

    if (x != 3) {
        play(melo_piano, 1)
    }

    x = x + 1
}

